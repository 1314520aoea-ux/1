name: PinToIsland 会员绕过
description: 拦截 wulonglin.xyz 的 get_membership.php API 响应，注入永久会员状态
dns: {}
scriptings:
  - http_response:
      name: pintoisland-membership
      match: "^https://wulonglin\\.xyz/api/get_membership\\.php"
      script: |
        console.log("[PinToIsland] Script started")
        console.log("[PinToIsland] URL: " + $request.url)
        console.log("[PinToIsland] Body type: " + typeof $response.body)
        console.log("[PinToIsland] Body length: " + ($response.body ? $response.body.length : 0))
        console.log("[PinToIsland] Script done")
        $done({})
      body_required: true
      max_size: 2097152
      timeout: 30
mitm:
  hostnames:
    includes:
      - wulonglin.xyz
